# ---------------------------------------------------------------------------
# CB Diner — copy to .env.local and fill in. Everything is optional:
# without the Supabase keys the app runs in demo mode (in-memory data).
# ---------------------------------------------------------------------------

# Public URL of the site (used for table QR codes, sitemap and share images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Postgres, Auth, Storage, Realtime) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-photos

# Restaurant details shown to guests
NEXT_PUBLIC_RESTAURANT_PHONE=(212) 555-0147
# WhatsApp number in international format, digits only (country code first)
NEXT_PUBLIC_WHATSAPP_NUMBER=12125550147
NEXT_PUBLIC_TABLE_COUNT=24
# Google Maps: the embed works without a key; set one to use the Maps Embed API
NEXT_PUBLIC_MAPS_QUERY=Park Avenue South, New York, NY
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Google Place ID for the "Write a review" link (https://developers.google.com/maps/documentation/places/web-service/place-id)
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# Demo deployments only: pretend it is this time in New York (e.g. 19:40) so the
# restaurant shows dinner service in screenshots. Leave empty for a real restaurant.
NEXT_PUBLIC_DEMO_TIME=

# Set to 1 to register the service worker during `npm run dev`
NEXT_PUBLIC_SW_DEV=
